* {
    /* Base Colors */
    background:                  rgba (18, 18, 18, 100 %);      /* Dark Charcoal/Black */
    foreground:                  rgba (176, 173, 173, 100 %);    /* Pure White */
    
    /* Functional Colors (Monochrome Mapping) */
    red:                         rgba (255, 255, 255, 100 %);
    blue:                        rgba (255, 255, 255, 100 %);
    lightbg:                     rgba (40, 40, 40, 100 %);
    lightfg:                     rgba (180, 180, 180, 100 %);

    /* Normal Row State */
    normal-foreground:           @foreground;
    normal-background:           @background;
    alternate-normal-foreground: @foreground;
    alternate-normal-background: @background;      /* Slightly off-black for alternating rows */

    /* Selected Row State */
    selected-normal-foreground:  rgba (18, 18, 18, 100 %);      /* Inverted: Black text */
    selected-normal-background:  rgba (176, 173, 173, 100 %);    /* Inverted: White highlight */

    /* Urgent Row State (High Contrast White Highlight) */
    urgent-foreground:           @foreground;
    urgent-background:           @background;
    alternate-urgent-foreground: @foreground;
    alternate-urgent-background: @alternate-normal-background;
    selected-urgent-foreground:  rgba (18, 18, 18, 100 %);
    selected-urgent-background:  rgba (220, 220, 220, 100 %);

    /* Active Row State */
    active-foreground:           @foreground;
    active-background:           @background;
    alternate-active-foreground: @foreground;
    alternate-active-background: @alternate-normal-background;
    selected-active-foreground:  rgba (18, 18, 18, 100 %);
    selected-active-background:  rgba (255, 255, 255, 100 %);

    /* Borders & Spacing */
    bordercolor:                 rgba (255, 255, 255, 100 %);    /* Solid White Border */
    border-color:                @bordercolor;
    separatorcolor:              rgba (80, 80, 80, 100 %);      /* Mid-gray separator */
    background-color:            rgba (0, 0, 0, 0 %);
    spacing:                     2;
}

window {
    background-color: @background;
    border: 1;
    padding: 5;
}

mainbox {
    border: 0;
    padding: 0;
}

message {
    border: 1px dash 0px 0px;
    border-color: @separatorcolor;
    padding: 1px;
}

textbox {
    text-color: @foreground;
}

listview {
    fixed-height: 0;
    border: 2px dash 0px 0px;
    border-color: @separatorcolor;
    spacing: 2px;
    scrollbar: true;
    padding: 2px 0px 0px;
}

element {
    border: 0;
    padding: 1px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

element.normal.normal {
    background-color: @normal-background;
    text-color: @normal-foreground;
}

element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

element.normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

element.selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

element.selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}

element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}

element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color: @alternate-urgent-foreground;
}

element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}

scrollbar {
    width: 4px;
    border: 0;
    handle-width: 8px;
    padding: 0;
}

mode-switcher {
    border: 2px dash 0px 0px;
    border-color: @separatorcolor;
}

button.selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

inputbar {
    spacing: 0;
    text-color: @normal-foreground;
    padding: 1px;
}

case-indicator {
    spacing: 0;
    text-color: @normal-foreground;
}

entry {
    spacing: 0;
    text-color: @normal-foreground;
}

prompt {
    spacing: 0;
    text-color: @normal-foreground;
}

inputbar {
    children: [ prompt, textbox-prompt-colon, entry, case-indicator];
}

textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0px 0.3em 0em 0em;
    text-color: @normal-foreground;
}
