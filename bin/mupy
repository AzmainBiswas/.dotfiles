#!/usr/bin/env python3

### Configs
DB_PATH = "./mupy.db"

import argparse
import sqlite3
import subprocess

CONNECTION: sqlite3.Connection


def init_db():
    """Initilize the database, create all the tables"""
    with CONNECTION:
        _ = CONNECTION.execute("PRAGMA foreign_keys = ON;")
        _ = CONNECTION.execute("""
            CREATE TABLE IF NOT EXISTS songs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                artist TEXT NOT NULL,
                path TEXT NOT NULL UNIQUE
            );
        """)
        _ = CONNECTION.execute("""
            CREATE TABLE IF NOT EXISTS playlists (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE
            );
        """)
        _ = CONNECTION.execute("""
            CREATE TABLE IF NOT EXISTS playlist_songs (
                playlist_id INTEGER NOT NULL,
                song_id INTEGER NOT NULL,

                FOREIGN KEY (playlist_id)
                    REFERENCES playlists(id)
                    ON DELETE CASCADE,

                FOREIGN KEY (song_id)
                    REFERENCES songs(id)
                    ON DELETE CASCADE
            );
        """)


def print_song_list(args: argparse.Namespace):
    with CONNECTION:
        cur = CONNECTION.execute("SELECT title, artist, path FROM songs")
    rows = cur.fetchall()
    parts = []
    for t, a, u in rows:
        filds = []
        if args.title:
            filds.append(t)
        if args.artist:
            filds.append(a)
        if args.url:
            filds.append(u)

        if not args.title and not args.artist and not args.url:
            filds.append(u)
        parts.append("|".join(filds))
    print("\n".join(parts), flush=True)
    # TODO: need to remove the print here store the output.


def db_add_song(*song_data: tuple[str, str, str]) -> list[int] | None:
    paths = [d[2] for d in song_data]
    with CONNECTION:
        _ = CONNECTION.executemany(
            "INSERT OR IGNORE INTO songs (title, artist, path) VALUES (?, ?, ?)",
            song_data,
        )

        placeholders = ", ".join("?" for _ in paths)
        quary = f"SELECT id FROM songs WHERE path IN ({placeholders})"
        rows = CONNECTION.execute(quary, paths).fetchall()
    return [row[0] for row in rows if row is not None] if rows is not None else None


def db_create_playlist(playlist_name: str) -> int | None:
    with CONNECTION:
        _ = CONNECTION.execute(
            "INSERT OR IGNORE INTO playlists (name) VALUES (?)", (playlist_name,)
        )
        row = CONNECTION.execute(
            "SELECT id FROM playlists WHERE name = ?", (playlist_name,)
        ).fetchall()
    return row[0][0] if row is not None else None


def db_add_song_to_playlist(pll_id: int, *song_ids: int):
    payload = [(pll_id, s) for s in song_ids]
    with CONNECTION:
        _ = CONNECTION.executemany(
            "INSERT OR IGNORE INTO playlist_songs (playlist_id, song_id) VALUES (?, ?)",
            payload,
        )


def db_add_to_playlist(
    user_pll: str | None,
    *playlist_data: tuple[str, str, str, str],
):
    pll_ids: dict[str, int] = {}
    for pll_name, title, artist, url in playlist_data:
        if user_pll is not None:
            pll_name = user_pll
        if pll_name not in pll_ids:
            pll_id = db_create_playlist(pll_name)
            assert pll_id, "playlist id not found"
            pll_ids[pll_name] = pll_id
        song_ids = db_add_song((title, artist, url))
        assert song_ids, "song id not found"
        db_add_song_to_playlist(pll_ids[pll_name], *song_ids)


def extract_youtube_songs_data(*song_url: str) -> list[tuple[str, str, str]]:
    proparties = "%(title)s\t%(channel)s\t%(webpage_url)s"
    result = subprocess.run(
        [
            "yt-dlp",
            "--skip-download",
            "--no-warnings",
            "--print",
            proparties,
            *song_url,
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    songs = []
    for line in result.stdout.splitlines():
        title, artist, url = line.split("\t", 2)
        songs.append((title, artist, url))
    return songs


def extract_youtube_playlist_data(
    *playlist_url: str,
) -> list[tuple[str, str, str, str]]:
    proparties = "%(playlist)s\t%(title)s\t%(channel)s\t%(webpage_url)s"
    result = subprocess.run(
        [
            "yt-dlp",
            "--skip-download",
            "--no-warnings",
            "--flat-playlist",
            "--print",
            proparties,
            *playlist_url,
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    songs = []
    for line in result.stdout.splitlines():
        pll, title, artist, url = line.split("\t", 3)
        songs.append((pll, title, artist, url))
    return songs


def parse_commandline() -> argparse.Namespace:
    parser = argparse.ArgumentParser("mupy")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # TODO: add search functionality
    song = subparsers.add_parser("song", help="operatation on songs")
    _ = song.add_argument(
        "--add",
        "-a",
        dest="path",
        help="add a songs to list",
        action="extend",
        nargs="+",
    )
    _ = song.add_argument(
        "--pl",
        "-p",
        dest="pll",
        help="add songs to a particuler playlist. Works only with --add",
    )
    _ = song.add_argument(
        "--list", "-l", help="List all songs (default is -u)", action="store_true"
    )
    _ = song.add_argument(
        "-t",
        dest="title",
        help="show title of songs, works with --list only",
        action="store_true",
    )
    _ = song.add_argument(
        "-c",
        dest="artist",
        help="show artist name of songs, works with --list only",
        action="store_true",
    )
    _ = song.add_argument(
        "-u",
        dest="url",
        help="show url name of songs, works with --list only",
        action="store_true",
    )

    # TODO: handle artist
    artist = subparsers.add_parser("artist", help="operatation on artist")
    _ = artist.add_argument("name", help="find artist name")
    _ = artist.add_argument("--list", "-l", help="list all artist", action="store_true")
    _ = artist.add_argument(
        "-t",
        dest="title",
        help="show title of songs, works with --list only",
        action="store_true",
    )
    _ = artist.add_argument(
        "-u",
        dest="url",
        help="show url name of songs, works with --list only",
        action="store_true",
    )

    # TODO: handle playlist
    pll = subparsers.add_parser("pll", help="operatation on playlist")
    _ = pll.add_argument("name", nargs="?", help="find with playlist note")
    _ = pll.add_argument("--add", "-a", help="add songs to playlist by id (<id>, <id>)")
    _ = pll.add_argument(
        "--add-url",
        "-u",
        dest="url",
        help="add playlist from url",
    )

    return parser.parse_args()


def process_song_command(args: argparse.Namespace):
    if args.list == True:
        print_song_list(args)
    elif args.path:
        songs_data = extract_youtube_songs_data(*args.path)
        song_id = db_add_song(*songs_data)
        assert song_id, "did't find songs"
        if args.pll:
            pll_id = db_create_playlist(args.pll)
            assert pll_id, "did't find playlist"
            db_add_song_to_playlist(pll_id, *song_id)


def process_artist_command(args: argparse.Namespace):
    raise NotImplementedError("artist sub command is not yes implemented")


def process_playlist_command(args: argparse.Namespace):
    if args.url is not None:
        playlist_data = extract_youtube_playlist_data(args.url)
        db_add_to_playlist(args.name, *playlist_data)
    elif args.add is not None:
        pass
    else:
        raise NotImplementedError()


# TODO: add fuzzy search with builtin difflib get_close_match
def main():
    global CONNECTION
    with sqlite3.connect(f"file:{DB_PATH}?mode=rwc", uri=True) as CONNECTION:
        init_db()
        args = parse_commandline()
        # print(args) #DEBUG:
        if args.subcommand == "song":
            process_song_command(args)
        if args.subcommand == "artist":
            process_artist_command(args)
        if args.subcommand == "pll":
            process_playlist_command(args)

if __name__ == "__main__":
    main()


