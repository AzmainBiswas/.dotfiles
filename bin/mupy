#!/usr/bin/env python3

### Configs
DB_PATH = "./mupy.db"

import argparse
import sqlite3
import subprocess
import sys


def init_db(conn: sqlite3.Connection):
    """Initilize the database, create all the tables"""
    with conn:
        _ = conn.execute("PRAGMA foreign_keys = ON;")
        _ = conn.execute("""
            CREATE TABLE IF NOT EXISTS songs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                artist TEXT NOT NULL,
                path TEXT NOT NULL UNIQUE
            );
        """)
        _ = conn.execute("""
            CREATE TABLE IF NOT EXISTS playlists (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE
            );
        """)
        _ = conn.execute("""
            CREATE TABLE IF NOT EXISTS playlist_songs (
                playlist_id INTEGER NOT NULL,
                song_id INTEGER NOT NULL,

                FOREIGN KEY (playlist_id)
                    REFERENCES playlists(id)
                    ON DELETE CASCADE,

                FOREIGN KEY (song_id)
                    REFERENCES songs(id)
                    ON DELETE CASCADE
            );
        """)


def print_song_list(conn: sqlite3.Connection, args: argparse.Namespace):
    with conn:
        cur = conn.execute("SELECT title, artist, path FROM songs")
    rows = cur.fetchall()
    parts = []
    for t, a, u in rows:  # pyright: ignore[reportAny]
        filds = []
        if args.title:  # pyright: ignore[reportAny]
            filds.append(t)  # pyright: ignore[reportUnknownMemberType, reportAny]
        if args.artist:  # pyright: ignore[reportAny]
            filds.append(a)  # pyright: ignore[reportUnknownMemberType, reportAny]
        if args.url:  # pyright: ignore[reportAny]
            filds.append(u)  # pyright: ignore[reportUnknownMemberType, reportAny]

        if not args.title and not args.artist and not args.url:  # pyright: ignore[reportAny]
            filds.append(u)  # pyright: ignore[reportUnknownMemberType, reportAny]
        parts.append("|".join(filds))  # pyright: ignore[reportUnknownArgumentType, reportUnknownMemberType]
    print("\n".join(parts), flush=True)  # pyright: ignore[reportUnknownArgumentType]
    # TODO: need to remove the print here store the output.


def db_add_song(
        conn: sqlite3.Connection, *song_data: tuple[str, str, str]
        ) -> list[int] | None:
    paths = [d[2] for d in song_data]
    with conn:
        _ = conn.executemany(
            "INSERT OR IGNORE INTO songs (title, artist, path) VALUES (?, ?, ?)",
            song_data,
        )

        placeholders = ", ".join("?" for _ in paths)
        quary = f"SELECT id FROM songs WHERE path IN ({placeholders})"
        rows = conn.execute(quary, paths).fetchall()
    return [row[0] for row in rows if row is not None] if rows is not None else None  # pyright: ignore[reportUnnecessaryComparison, reportAny]


def create_playlist(conn: sqlite3.Connection, playlist_name: str) -> int | None:
    with conn:
        _ = conn.execute(
            "INSERT OR IGNORE INTO playlists (name) VALUES (?)", (playlist_name,)
        )
        row = conn.execute(
            "SELECT id FROM playlists WHERE name = ?", (playlist_name,)
        ).fetchall()
    return row[0][0] if row is not None else None  # pyright: ignore[reportUnnecessaryComparison]


def add_song_to_playlist(conn: sqlite3.Connection, pll_id: int, *song_ids: int):
    payload = [(pll_id, s) for s in song_ids]
    with conn:
        _ = conn.executemany(
            "INSERT OR IGNORE INTO playlist_songs (playlist_id, song_id) VALUES (?, ?)",
            payload
        )


def extract_youtube_songs_data(*song_url: str):
    proparties = "%(title)s\t%(channel)s\t%(webpage_url)s"
    result = subprocess.run(
        [
            "yt-dlp",
            "--skip-download",
            "--no-warnings",
            "--print",
            proparties,
            *song_url,
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    return [
        tuple(d for d in line.strip().split("\t"))
        for line in result.stdout.splitlines()
    ]


def parse_commandline() -> argparse.Namespace:
    parser = argparse.ArgumentParser("mupy")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # TODO: add search functionality
    song = subparsers.add_parser("song", help="operatation on songs")
    _ = song.add_argument(
        "--add",
        "-a",
        dest="path",
        help="add a songs to list",
        action="extend",
        nargs="+",
    )
    _ = song.add_argument(
        "--pll", "-p", help="add songs to a particuler playlist. Works only with --add"
    )
    _ = song.add_argument(
        "--list", "-l", help="List all songs (default is -u)", action="store_true"
    )
    _ = song.add_argument(
        "-t",
        dest="title",
        help="show title of songs, works with --list only",
        action="store_true",
    )
    _ = song.add_argument(
        "-c",
        dest="artist",
        help="show artist name of songs, works with --list only",
        action="store_true",
    )
    _ = song.add_argument(
        "-u",
        dest="url",
        help="show url name of songs, works with --list only",
        action="store_true",
    )

    # TODO: handle artist
    artist = subparsers.add_parser("artist", help="operatation on artist")
    _ = artist.add_argument("name", help="find artist name")
    _ = artist.add_argument("--list", "-l", help="list all artist", action="store_true")
    _ = artist.add_argument(
        "-t",
        dest="title",
        help="show title of songs, works with --list only",
        action="store_true",
    )
    _ = artist.add_argument(
        "-u",
        dest="url",
        help="show url name of songs, works with --list only",
        action="store_true",
    )

    # TODO: handle playlist
    pll = subparsers.add_parser("pll", help="operatation on playlist")
    _ = pll.add_argument("name", help="find with playlist note")
    _ = pll.add_argument("--add", "-a", help="add playlist")
    _ = pll.add_argument(
        "--add-url",
        "-u",
        dest="url",
        help="add playlist from url",
    )

    return parser.parse_args()


def process_song_command(conn: sqlite3.Connection, args: argparse.Namespace):
    if args.list == True:  # pyright: ignore[reportAny]
        print_song_list(conn, args)
    elif args.path:  # pyright: ignore[reportAny]
        songs_data = extract_youtube_songs_data(*args.path)  # pyright: ignore[reportAny]
        song_id = db_add_song(conn, *songs_data)  # pyright: ignore[reportArgumentType]
        assert song_id, "did't find songs"
        if args.pll:  # pyright: ignore[reportAny]
            pll_id = create_playlist(conn, args.pll)  # pyright: ignore[reportAny]
            assert pll_id, "did't find playlist"
            add_song_to_playlist(conn, pll_id, *song_id)


def process_artist_command(conn: sqlite3.Connection, args: argparse.Namespace):
    raise NotImplementedError("artist sub command is not yes implemented")


def process_playlist_command(conn: sqlite3.Connection, args: argparse.Namespace):
    if args.url:
        print(args.url)
        print(args)
    else:
        raise NotImplementedError()


def main():
    with sqlite3.connect(f"file:{DB_PATH}?mode=rwc", uri=True) as conn:
        init_db(conn)
        args = parse_commandline()
        # print(args) #DEBUG:
        if args.subcommand == "song":  # pyright: ignore[reportAny]
            process_song_command(conn, args)
        if args.subcommand == "artist":
            process_artist_command(conn, args)
        if args.subcommand == "pll":
            process_playlist_command(conn, args)


if __name__ == "__main__":
    main()
