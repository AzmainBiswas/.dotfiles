#!/usr/bin/env python3

### Configs
DB_PATH = "./mupy.db"

import sqlite3
import argparse
import subprocess


def init_db(conn: sqlite3.Connection):
    """Initilize the database, create all the tables"""
    with conn:
        _ = conn.execute("PRAGMA foreign_keys = ON;")
        _ = conn.execute("""
            CREATE TABLE IF NOT EXISTS songs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                artist TEXT NOT NULL,
                path TEXT NOT NULL UNIQUE
            );
        """)
        _ = conn.execute("""
            CREATE TABLE IF NOT EXISTS playlists (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE
            );
        """)
        _ = conn.execute("""
            CREATE TABLE IF NOT EXISTS playlist_songs (
                playlist_id INTEGER NOT NULL,
                song_id INTEGER NOT NULL,
                position INTEGER NOT NULL,

                FOREIGN KEY (playlist_id)
                    REFERENCES playlists(id)
                    ON DELETE CASCADE,

                FOREIGN KEY (song_id)
                    REFERENCES songs(id)
                    ON DELETE CASCADE
            );
        """)

def print_song_list(conn: sqlite3.Connection, args: argparse.Namespace):
    with conn:
        cur = conn.execute("SELECT id title, artist, path FROM songs")
    rows = cur.fetchall()
    parts = []
    for t, a, u in rows:  # pyright: ignore[reportAny]
        filds = []
        if args.title:  # pyright: ignore[reportAny]
            filds.append(t)  # pyright: ignore[reportUnknownMemberType, reportAny]
        if args.artist:  # pyright: ignore[reportAny]
            filds.append(a)  # pyright: ignore[reportUnknownMemberType, reportAny]
        if args.url:  # pyright: ignore[reportAny]
            filds.append(u)  # pyright: ignore[reportUnknownMemberType, reportAny]

        if not args.title and not args.artist and not args.url:  # pyright: ignore[reportAny]
            filds.append(u)  # pyright: ignore[reportUnknownMemberType, reportAny]
        parts.append("|".join(filds))  # pyright: ignore[reportUnknownArgumentType, reportUnknownMemberType]
    print("\n".join(parts), flush=True)  # pyright: ignore[reportUnknownArgumentType] 
    #TODO: need to remove the print here store the output.

def db_add_song(conn: sqlite3.Connection, title: str, artist: str, path: str):
    with conn:
        _ = conn.execute("INSERT OR IGNORE INTO songs (title, artist, path) VALUES (?, ?, ?)",
                           (title, artist, path))

        cur = conn.execute(f"SELECT id FROM songs WHERE path = ?", (path,))
    row = cur.fetchall()
    if row is not None:  # pyright: ignore[reportUnnecessaryComparison]
        return row[0]  # pyright: ignore[reportAny]

def extract_youtube_song_data(song_url: str):
    proparties = "%(title)s\t%(channel)s\t%(webpage_url)s"
    result = subprocess.run(
            [
                "yt-dlp", 
                "--skip-download",
                "--no-warnings",
                "--print", proparties, 
                song_url, 
            ],
            check=True, 
            capture_output=True, 
            text=True)
    title, artist, path = [s.strip() for s in result.stdout.split("\t")]
    return (title, artist, path)

def parse_commandline() -> argparse.Namespace:
    parser = argparse.ArgumentParser("mupy")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    #TODO: add song directely to playlist
    songs = subparsers.add_parser("songs", help="operatation on songs")
    _ = songs.add_argument("--add", "-a", dest="path", help="add a songs to list", action="extend", nargs="+")
    _ = songs.add_argument("--list", "-l", help="List all songs (default is -u)", action="store_true")
    _ = songs.add_argument("-t", dest="title", help="show title of songs, works with --list only", action="store_true")
    _ = songs.add_argument("-c", dest="artist", help="show artist name of songs, works with --list only", action="store_true")
    _ = songs.add_argument("-u", dest="url", help="show url name of songs, works with --list only", action="store_true")

    #TODO: handle artist
    artist = subparsers.add_parser("artist", help="operatation on artist")
    _ = artist.add_argument("name", help="find artist name")
    _ = artist.add_argument("--list", "-l", help="list all artist", action="store_true")
    _ = artist.add_argument("-t", dest="title", help="show title of songs, works with --list only", action="store_true")
    _ = artist.add_argument("-u", dest="url", help="show url name of songs, works with --list only", action="store_true")

    #TODO: handle playlist

    return parser.parse_args()

def process_songs_command(conn: sqlite3.Connection, args: argparse.Namespace):
    if args.list == True:  # pyright: ignore[reportAny]
        print_song_list(conn, args)
    elif args.path:  # pyright: ignore[reportAny]
        for path in args.path: # pyright: ignore[reportAny]
            title, artist, path = extract_youtube_song_data(path)    # pyright: ignore[reportAny]
            _ = db_add_song(conn, title, artist, path)
        

def main():
    with sqlite3.connect(f"file:{DB_PATH}?mode=rwc", uri=True) as conn:
        init_db(conn)
        args = parse_commandline()
        # print(args) #DEBUG:
        if args.subcommand == "songs":  # pyright: ignore[reportAny]
            process_songs_command(conn, args)


if __name__ == "__main__":
    main()
