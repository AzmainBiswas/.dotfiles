@dataclass
class NetworkDevice:
    name: str
    type: str
    state: str
    connection: str

    @property
    def is_connected(self) -> bool:
        return self.state.startswith("connected")

    @property
    def is_physical(self) -> bool:
        return self.type in ["wifi", "ethernet"]


@dataclass
class WifiNetwork:
    in_use: bool
    ssid: str
    band: str
    signal: int
    security: str


def run_cmd(args: str | list[str]) -> subprocess.CompletedProcess[str]:
    try:
        rep = subprocess.run(args, capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error: Command Fail with exit code {e.returncode}", file=sys.stderr)
        print(f"Error: Command run: {e.cmd}", file=sys.stderr)  # pyright: ignore[reportAny]
        print(f"Error: {e.stderr}", file=sys.stderr)  # pyright: ignore[reportAny]
        sys.exit(e.returncode)
    except FileNotFoundError:
        print(
            f'Error: The "{args[0]}" command does not exist on this system.',
            file=sys.stderr,
        )
        sys.exit(2)

    return rep


def get_active_interface(target_ip: str = "8.8.8.8") -> str | None:
    """Get the active network interface name"""
    rep = run_cmd(["ip", "route", "get", target_ip])
    tokens = rep.stdout.split()
    if "dev" in tokens:
        return tokens[tokens.index("dev") + 1]

    return None


def get_network_devices() -> dict[str, NetworkDevice]:
    out = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"])
    devices: dict[str, NetworkDevice] = {}
    for line in out.stdout.splitlines():
        line = line.split(":", 4)
        devices[line[0]] = NetworkDevice(
            name=line[0], type=line[1], state=line[2], connection=line[3]
        )
    return devices


def get_list_of_network(rescan: bool = True) -> dict[str, WifiNetwork]:
    out = run_cmd(
        [
            "nmcli",
            "-t",
            "-f",
            "IN-USE,SSID,BAND,SIGNAL,SECURITY",
            "device",
            "wifi",
            "list",
            "--rescan",
            "yes" if rescan else "no",
        ]
    )
    wifi_networks: dict[str, WifiNetwork] = {}
    for line in out.stdout.splitlines():
        in_use, ssid, band, signal, security = line.split(":", 5)
        if not ssid:
            continue
        in_use = "*" == in_use
        signal = int(signal)
        wifi_networks[ssid] = WifiNetwork(in_use, ssid, band, signal, security)
    return wifi_networks

def toggle_wifi_network():
    proc = run_cmd(["nmcli", "radio", "wifi"])
    if proc.stdout.splitlines()[0] == "enabled":
        _ = run_cmd(["nmcli", "radio", "wifi", "off"])
    else:
        _ = run_cmd(["nmcli", "radio", "wifi", "on"])

# TODO: handle is window size is less then the text
def text_box(
    stdscr: curses.window,
    txt: str,
    begin_y: int,
    begin_x: int,
    pad_h: int = 0,
    pad_w: int = 2,
) -> curses.window:
    height = 1 + 2 + (pad_h * 2)
    weidth = len(txt) + 2 + (pad_w * 2)
    win = stdscr.derwin(height, weidth, begin_y, begin_x)
    win.box()
    txt_y = height // 2
    txt_x = (weidth - len(txt)) // 2
    win.addstr(txt_y, txt_x, txt)
    win.refresh()
    return win


def draw_menu(stdscr: curses.window, titel: str, options: list[str], selected_idx: int):
    stdscr.clear()
    max_h, max_w = stdscr.getmaxyx()
    pad_w = 10
    start_h = 1
    start_w = max_w // 2 - (len(titel) + pad_w * 2 + 2) // 2
    win = text_box(stdscr, titel, start_h, start_w, pad_w=pad_w)
    w_y, _ = win.getmaxyx()
    m = max(len(f"  {o}  ") for o in options)
    for i, opt in enumerate(options):
        x = max_w // 2 - m // 2
        if i == selected_idx:
            stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
            stdscr.addstr(w_y + 1 + i, x , f"> {opt}  ")
            stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
        else:
            stdscr.addstr(w_y + 1 + i, x, f"  {opt}  ")
    stdscr.refresh()

def select_item(stdscr: curses.window, titel: str, options: list[str], selected: int = 0) -> int | None:
    if not options:
        return None
    while True:
        draw_menu(stdscr, titel, options, selected)
        key = stdscr.getch()
        if key in [curses.KEY_UP, ord('k')]:
            selected = (selected - 1) % len(options)
        elif key in [curses.KEY_DOWN, ord('j')]:
            selected = (selected + 1) % len(options)
        elif key in [curses.KEY_ENTER, 10, 13]:
            return selected
        elif key in [27, ord('q')]:
            return None


MAIN_MENU = [
    "1. 󰤨 Connect to Wi-Fi",
    "2. 󰌘 Change DNS Settings",
    "3. 󰤭 Disconnect Current Connection",
    "4.  Toggle Wi-Fi Radio (on|off)",
    "5. 󰈆 Exit"
]

def main(stdscr: curses.window):
    _ = curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(2, curses.COLOR_GREEN, curses.COLOR_BLACK)
    stdscr.nodelay(False)
    selected = 0
    while True:
        selected = select_item(stdscr, "NetWork Manager", MAIN_MENU, selected)
        if selected == None or selected + 1 == 5:
            break
        elif selected + 1 == 4:
            toggle_wifi_network()


if __name__ == "__main__":
    curses.wrapper(main)
