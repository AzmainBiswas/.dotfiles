#!/usr/bin/env python3

import argparse
import getpass
import subprocess
import sys
from dataclasses import dataclass
from turtle import back

DNS_PROFILES = {
    "Cloudflare": {
        "ipv4": "1.1.1.1 1.0.0.1",
        "ipv6": "2606:4700:4700::1111 2606:4700:4700::1001",
    },
    "Google": {
        "ipv4": "8.8.8.8 8.8.4.4",
        "ipv6": "2001:4860:4860::8888 2001:4860:4860::8844",
    },
    "Quad9": {
        "ipv4": "9.9.9.9 149.112.112.112",
        "ipv6": "2620:fe::fe 2620:fe::9",
    },
    "AdGuard DNS": {
        "ipv4": "94.140.14.14 94.140.15.15",
        "ipv6": "2a10:50c0::ad1:ff 2a10:50c0::ad2:ff",
    },
    "Reset to DHCP / Automatic": {
        "ipv4": "auto",
        "ipv6": "auto",
    },
    "Back": {},
}


@dataclass
class NetworkDevice:
    name: str
    type: str
    state: str
    connection: str

    @property
    def is_connected(self) -> bool:
        return self.state.startswith("connected")

    @property
    def is_physical(self) -> bool:
        return self.type in ["wifi", "ethernet"]


@dataclass
class WifiNetwork:
    in_use: bool
    ssid: str
    signal: int
    security: str


def run_cmd(args: str | list[str]) -> subprocess.CompletedProcess[str]:
    try:
        rep = subprocess.run(args, capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error: Command Fail with exit code {e.returncode}", file=sys.stderr)
        print(f"Error: Command run: {e.cmd}", file=sys.stderr)  # pyright: ignore[reportAny]
        print(f"Error: {e.stderr}", file=sys.stderr)  # pyright: ignore[reportAny]
        sys.exit(e.returncode)
    except FileNotFoundError:
        print(
            f'Error: The "{args[0]}" command does not exist on this system.',
            file=sys.stderr,
        )
        sys.exit(2)

    return rep


def menu_picker(options: list[str], prompt: str, backend: str) -> str | None:
    if backend == "fzf":
        cmd = [
            "fzf",
            "--prompt",
            f"{prompt}",
            "--height",
            "40%",
            "--reverse",
            "--border",
        ]
    elif backend == "rofi":
        cmd = ["rofi", "-dmenu", "-p", prompt, "-l", "5", "-i"]
    else:
        raise ValueError("Unknown Selector")

    proc = subprocess.run(
        cmd, input="\n".join(options), capture_output=True, text=True, check=False
    )
    if proc.returncode == 0 and proc.stdout:
        return proc.stdout.strip()
    return None


def get_active_interface(target_ip: str = "8.8.8.8") -> str | None:
    """Get the active network interface name"""
    rep = subprocess.run(
        ["ip", "route", "get", target_ip], capture_output=True, text=True, check=False
    )

    if rep.stderr:
        return None

    tokens = rep.stdout.split()
    if "dev" in tokens:
        return tokens[tokens.index("dev") + 1]

    return None


def get_network_devices() -> dict[str, NetworkDevice]:
    out = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"])
    devices: dict[str, NetworkDevice] = {}
    for line in out.stdout.splitlines():
        line = line.split(":", 4)
        devices[line[0]] = NetworkDevice(
            name=line[0], type=line[1], state=line[2], connection=line[3]
        )
    return devices


def get_list_of_network(rescan: bool = True) -> dict[str, WifiNetwork]:
    out = run_cmd(
        [
            "nmcli",
            "-t",
            "-f",
            "IN-USE,SSID,SIGNAL,SECURITY",
            "device",
            "wifi",
            "list",
            "--rescan",
            "yes" if rescan else "no",
        ]
    )
    wifi_networks: dict[str, WifiNetwork] = {}
    for line in out.stdout.splitlines():
        in_use, ssid, signal, security = line.split(":", 4)
        if not ssid:
            continue
        in_use = "*" == in_use
        signal = int(signal)
        wifi_networks[ssid] = WifiNetwork(in_use, ssid, signal, security)
    return wifi_networks


def toggle_wifi_device():
    proc = run_cmd(["nmcli", "radio", "wifi"])
    if proc.stdout.splitlines()[0] == "enabled":
        _ = run_cmd(["nmcli", "radio", "wifi", "off"])
    else:
        _ = run_cmd(["nmcli", "radio", "wifi", "on"])


def disconnect_wifi_conection():
    active_intervace = get_active_interface()
    if not active_intervace:
        return
    _ = run_cmd(["nmcli", "device", "disconnect", active_intervace])
    return


def change_dns(backend: str):
    options = [d[0] for d in DNS_PROFILES.items()]
    prompt = " [ Select DNS provider ] > "
    choice = menu_picker(options, prompt, backend)
    if choice is None or choice == options[-1]:
        return
    else:
        nds = get_network_devices()
        connections = [
            nd[1].connection
            for nd in nds.items()
            if nd[1].is_connected and nd[1].is_physical
        ]
        provider = DNS_PROFILES[choice]
        ipv4 = provider["ipv4"]
        ipv6 = provider["ipv6"]

        for connection in connections:
            if ipv4 == "auto":
                _ = run_cmd(
                    ["nmcli", "connection", "modify", connection, "ipv4.dns", ""]
                )
                _ = run_cmd(
                    [
                        "nmcli",
                        "connection",
                        "modify",
                        connection,
                        "ipv4.ignore-auto-dns",
                        "no",
                    ]
                )
            else:
                _ = run_cmd(
                    ["nmcli", "connection", "modify", connection, "ipv4.dns", ipv4]
                )
                _ = run_cmd(
                    [
                        "nmcli",
                        "connection",
                        "modify",
                        connection,
                        "ipv4.ignore-auto-dns",
                        "yes",
                    ]
                )

            _ = run_cmd(["nmcli", "connection", "up", connection])
        print(f"Dns changed to {choice}")
        send_notification(f"DNS {choice}", f"DNS changed sucessfully to {choice}")
        return


def draw_bar(num: int, max: int, max_bar: int = 10) -> str:
    p = int((max_bar / max) * num)
    return "#" * p + "-" * (max_bar - p)


def send_notification(summary: str, body: str = ""):
    _ = run_cmd(
        [
            "notify-send",
            "--app-name=network-tui",
            "--icon=network-wireless",
            summary,
            body,
        ]
    )

def get_password(backend: str) -> str:
    password: str = ""
    if backend == "fzf":
        password = getpass.getpass(
            "Enter Password (Keep Empty for no password): ", echo_char="*"
        ).strip()  # change for rofi
    elif backend == "rofi":
       res = run_cmd(["rofi", "-dmenu", "-l", "0", "-password"])
       password = res.stdout.splitlines()[0].strip()

    return password



def connect_wifi(backend: str):
    delimiter = "\u200b"
    wifi_lists = get_list_of_network(True)
    wifi_names = [
        f"{w[0]} {delimiter} ({w[1].signal}) {delimiter} {'*' if w[1].in_use else ''} "
        for w in wifi_lists.items()
    ]
    prompt = " [ Select Network ] > "
    choice = menu_picker(wifi_names, prompt, backend)
    if choice is None:
        return
    ssid = choice.split(delimiter)[0].strip()
    wifi = wifi_lists[ssid]
    saved = run_cmd(["nmcli", "-t", "-f", "NAME", "connection"]).stdout.splitlines()
    if wifi.ssid in saved:
        _ = run_cmd(["nmcli", "connection", "up", ssid])
    else:
        password = get_password(backend)
        if password:
            _ = run_cmd(
                ["nmcli", "device", "wifi", "connect", wifi.ssid, "password", password]
            )
        else:
            _ = run_cmd(["nmcli", "device", "wifi", "connect", wifi.ssid])
    print(f"Connected to {wifi.ssid}.")
    send_notification(f"{wifi.ssid}", f"Connected to {wifi.ssid}")


MAIN_MENU = [
    "1. 󰤨  Connect to Wi-Fi",
    "2. 󰌘  Change DNS Settings",
    "3. 󰤭  Disconnect Current Connection",
    "4.   Toggle Wi-Fi Radio (on|off)",
    "5. 󰈆  Exit",
]

def parse_argument() -> argparse.Namespace:
    parser = argparse.ArgumentParser("network-tui")
    _ = parser.add_argument("-r", action="store_true", help="use rofi")
    return parser.parse_args() 


def main():
    backend = "fzf"
    
    cmd = parse_argument()
    if cmd.r:
        backend = "rofi"

    try:
        while True:
            nds = get_network_devices()
            active_nds = [
                nd[1] for nd in nds.items() if nd[1].is_physical and nd[1].is_connected
            ]
            active_networks = ", ".join(n.connection for n in active_nds)
            prompt = (
                f" [ {active_networks} ] >  "
                if active_networks != ""
                else " [ Select ] > "
            )
            choice = menu_picker(MAIN_MENU, prompt, backend)
            if choice is None or choice == MAIN_MENU[-1]:
                return
            if choice == MAIN_MENU[3]:
                toggle_wifi_device()
            if choice == MAIN_MENU[2]:
                disconnect_wifi_conection()
            if choice == MAIN_MENU[1]:
                change_dns(backend)
                return
            if choice == MAIN_MENU[0]:
                connect_wifi(backend)
                return
    except KeyboardInterrupt:
        sys.exit(0)


if __name__ == "__main__":
    main()
